<!doctype html>

<html lang="fr">
    <head>
        <meta charset="utf-8">

        <meta
            name="viewport"
            content="width=device-width, initial-scale=1"
        >

        <title>
            {% block title %}
                PosteFlow
            {% endblock %}
        </title>

        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
            rel="stylesheet"
        >

        <style>
            body {
                min-height: 100vh;
                background-color: #f6f7fb;
            }

            .navbar-posteflow {
                background-color: #ffc928;
            }

            .card {
                border: 0;
                box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
            }
        </style>
    </head>

    <body>
        {% if app.user %}
            <nav class="navbar navbar-expand-lg navbar-posteflow mb-4">
                <div class="container">
                    <a
                        class="navbar-brand fw-bold"
                        href="{{ path('app_dashboard') }}"
                    >
                        📦 PosteFlow
                    </a>

                    <button
                        class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navigationPrincipale"
                        aria-controls="navigationPrincipale"
                        aria-expanded="false"
                        aria-label="Afficher ou masquer la navigation"
                    >
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div
                        id="navigationPrincipale"
                        class="collapse navbar-collapse"
                    >
                        <div class="navbar-nav">
                            <a
                                class="nav-link"
                                href="{{ path('app_colis_index') }}"
                            >
                                Colis
                            </a>

                            <a
                                class="nav-link"
                                href="{{ path('app_client_index') }}"
                            >
                                Clients
                            </a>

                            <a
                                class="nav-link"
                                href="{{ path('app_agence_index') }}"
                            >
                                Agences
                            </a>
                        </div>

                        <div class="ms-auto d-flex align-items-center gap-3">
                            <span>
                                {{ app.user.nom }}
                            </span>

                            <a
                                class="btn btn-sm btn-dark"
                                href="{{ path('app_logout') }}"
                            >
                                Déconnexion
                            </a>
                        </div>
                    </div>
                </div>
            </nav>
        {% endif %}

        <main class="container pb-5">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    {% set alertClass = label in [
                        'success',
                        'danger',
                        'warning',
                        'info'
                    ] ? label : 'info' %}

                    <div
                        class="alert alert-{{ alertClass }} alert-dismissible fade show"
                        role="alert"
                    >
                        {{ message }}

                        <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Fermer"
                        ></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}
            {% endblock %}
        </main>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>