{% extends 'base.html.twig' %}

{% block title %}
    Colis — {{ parent() }}
{% endblock %}

{% block body %}

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1 class="mb-0">
            Colis
        </h1>

        {% if is_granted('COLIS_CREATE') %}

            <a
                href="{{ path('app_colis_new') }}"
                class="btn btn-dark"
            >
                Nouveau colis
            </a>

        {% endif %}

    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            {{ form_start(searchForm, {
                attr: {
                    class: 'row g-3 align-items-end'
                }
            }) }}

                <div class="col-lg-5">

                    {{ form_row(searchForm.terme) }}

                </div>

                <div class="col-lg-3">

                    {{ form_row(searchForm.ville) }}

                </div>

                <div class="col-lg-2">

                    {{ form_row(searchForm.statut) }}

                </div>

                <div class="col-lg-2">
                    <div class="d-grid gap-2 d-flex">
                        <button
                            class="btn btn-dark"
                            type="submit"
                        >
                            Rechercher
                        </button>

                        {% if search.hasCriteria %}
                            <a
                                href="{{ path('app_colis_index') }}"
                                class="btn btn-outline-secondary"
                            >
                                Réinitialiser
                            </a>
                        {% endif %}
                    </div>
                </div>

                {{ form_end(searchForm) }}

        </div>

    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Suivi</th>
                            <th scope="col">Client</th>
                            <th scope="col">Destinataire</th>
                            <th scope="col">Ville</th>
                            <th scope="col">Statut</th>
                            <th class="text-end">
                                Actions
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for colis in items %}
                            <tr>
                                <td>
                                    <span class="fw-semibold">
                                        {{ colis.numeroSuivi }}
                                    </span>
                                </td>

                                <td>
                                    {{ colis.client.nom }}
                                </td>

                                <td>
                                    {{ colis.destinataire }}
                                </td>

                                <td>
                                    {{ colis.villeLivraison }}
                                </td>

                                <td>
                                    <span class="badge {{ colis.statut.badgeClass }}">
                                        {{ colis.statut.label }}
                                    </span>
                                </td>

                                <td class="text-end text-nowrap">
                                    {# Il y a un sujet à transmettre : l’entité colis. #}
                                    {% if is_granted('COLIS_VIEW', colis) %}
                                        <a
                                            class="btn btn-sm btn-outline-dark"
                                            href="{{ path('app_colis_show', {
                                                id: colis.id
                                            }) }}"
                                        >
                                            Suivre
                                        </a>
                                    {% endif %}

                                    {% if is_granted('COLIS_EDIT', colis) %}
                                        <a
                                            class="btn btn-sm btn-outline-secondary"
                                            href="{{ path('app_colis_edit', {
                                                id: colis.id
                                            }) }}"
                                        >
                                            Modifier
                                        </a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td
                                    colspan="6"
                                    class="text-center text-muted py-4"
                                >
                                    Aucun colis trouvé.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}