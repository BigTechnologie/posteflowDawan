{% extends 'base.html.twig' %}
{% block title %}Connexion
{% endblock %}
{% block body %}
	<div class="row justify-content-center">
		<div class="col-md-5">
			<div class="card p-4">
				<h1 class="h4 mb-3">Connexion PosteFlow</h1>
				{% if error %}
					<div class="alert alert-danger">Identifiants invalides.</div>
				{% endif %}
				<form method="post">
					<label>Email</label><input class="form-control mb-3" name="_username" value="{{ last_username }}"><label>Mot de passe</label><input class="form-control mb-3" type="password" name="_password"><input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"><button class="btn btn-dark w-100">Se connecter</button>
				</form>
				<p class="mt-3 small text-muted">Compte fixture : admin@posteflow.test / admin1234</p>
			</div>
		</div>
	</div>
{% endblock %}

