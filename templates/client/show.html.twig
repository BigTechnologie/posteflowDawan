{% extends 'base.html.twig' %}

{% block title %}
    {{ item.nom }} — {{ parent() }}
{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="mb-1">
                {{ item.nom }}
            </h1>

            <p class="text-muted mb-0">
                Fiche client
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a
                class="btn btn-outline-secondary"
                href="{{ path('app_client_index') }}"
            >
                Retour à la liste
            </a>

            {% if is_granted('CLIENT_EDIT', item) %}
                <a
                    class="btn btn-outline-dark"
                    href="{{ path('app_client_edit', {
                        id: item.id
                    }) }}"
                >
                    Modifier
                </a>
            {% endif %}

            {% if is_granted('CLIENT_DELETE', item) %}
                <form
                    method="post"
                    action="{{ path('app_client_delete', {
                        id: item.id
                    }) }}"
                    onsubmit="return confirm('Confirmer la suppression de ce client ?');"
                >
                    <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token('delete' ~ item.id) }}"
                    >

                    <button
                        type="submit"
                        class="btn btn-outline-danger"
                    >
                        Supprimer
                    </button>
                </form>
            {% endif %}
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="h5 mb-3">
                Informations du client
            </h2>

            <dl class="row mb-0">
                <dt class="col-sm-4">
                    Identifiant
                </dt>

                <dd class="col-sm-8">
                    {{ item.id }}
                </dd>

                <dt class="col-sm-4">
                    Nom
                </dt>

                <dd class="col-sm-8">
                    {{ item.nom }}
                </dd>

                <dt class="col-sm-4">
                    Adresse e-mail
                </dt>

                <dd class="col-sm-8">
                    {% if item.email %}
                        <a href="mailto:{{ item.email }}">
                            {{ item.email }}
                        </a>
                    {% else %}
                        <span class="text-muted">
                            Non renseignée
                        </span>
                    {% endif %}
                </dd>

                <dt class="col-sm-4">
                    Téléphone
                </dt>

                <dd class="col-sm-8">
                    {% if item.telephone %}
                        <a href="tel:{{ item.telephone }}">
                            {{ item.telephone }}
                        </a>
                    {% else %}
                        <span class="text-muted">
                            Non renseigné
                        </span>
                    {% endif %}
                </dd>

                <dt class="col-sm-4">
                    Adresse
                </dt>

                <dd class="col-sm-8">
                    {{ item.adresse }}<br>
                    {{ item.codePostal }}
                    {{ item.ville }}
                </dd>

                <dt class="col-sm-4">
                    Agence de référence
                </dt>

                <dd class="col-sm-8">
                    {% if item.agenceReference %}
                        {{ item.agenceReference.nom }}
                        — {{ item.agenceReference.ville }}
                    {% else %}
                        <span class="text-muted">
                            Non renseignée
                        </span>
                    {% endif %}
                </dd>
            </dl>
        </div>
    </div>
{% endblock %}