{% extends 'base.html.twig' %}

{% block title %}
    Clients — {{ parent() }}
{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">
            Clients
        </h1>

        {% if is_granted('CLIENT_CREATE') %}
            <a
                class="btn btn-dark"
                href="{{ path('app_client_new') }}"
            >
                Ajouter un client
            </a>
        {% endif %}
    </div>

    <form
        method="get"
        action="{{ path('app_client_index') }}"
        class="mb-3"
    >
        <div class="input-group">
            <input
                type="search"
                class="form-control"
                name="q"
                value="{{ q }}"
                placeholder="Rechercher un client"
            >

            <button
                type="submit"
                class="btn btn-dark"
            >
                Rechercher
            </button>

            {% if q %}
                <a
                    class="btn btn-outline-secondary"
                    href="{{ path('app_client_index') }}"
                >
                    Réinitialiser
                </a>
            {% endif %}
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">
                                ID
                            </th>

                            <th scope="col">
                                Nom
                            </th>

                            <th scope="col">
                                Ville
                            </th>

                            <th
                                scope="col"
                                class="text-end"
                            >
                                Actions
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for client in items %}
                            <tr>
                                <td>
                                    {{ client.id }}
                                </td>

                                <td class="fw-semibold">
                                    {{ client.nom }}
                                </td>

                                <td>
                                    {{ client.ville }}
                                </td>

                                <td class="text-end text-nowrap">
                                    {% if is_granted('CLIENT_VIEW', client) %}
                                        <a
                                            class="btn btn-sm btn-outline-dark"
                                            href="{{ path('app_client_show', {
                                                id: client.id
                                            }) }}"
                                        >
                                            Voir
                                        </a>
                                    {% endif %}

                                    {% if is_granted('CLIENT_EDIT', client) %}
                                        <a
                                            class="btn btn-sm btn-outline-secondary"
                                            href="{{ path('app_client_edit', {
                                                id: client.id
                                            }) }}"
                                        >
                                            Modifier
                                        </a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td
                                    colspan="4"
                                    class="text-center text-muted py-4"
                                >
                                    Aucun client ne correspond à la recherche.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}